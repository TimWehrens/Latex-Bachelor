<bpmn:messageFlow id="m4" sourceRef="T5" targetRef="P_Anwender"/>
<bpmn:messageFlow id="m5" sourceRef="T6" targetRef="P_Anwender"/>
</bpmn:collaboration>
<bpmn:process id="Proc_Ist" isExecutable="false">
<bpmn:laneSet id="LS_Ist">
<bpmn:lane id="L_FL" name="First-Level-Support"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_SL" name="Second-Level-Support"><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Störungsmeldung eingegangen"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="med_S1"/></bpmn:startEvent>
<bpmn:task id="T1" name="Ticket erfassen"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:task id="T2" name="Ticket kategorisieren"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:task id="T3" name="Ticket priorisieren"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
<bpmn:task id="T4" name="Erstdiagnose durchführen"><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G1" name="Lösung im First Level möglich?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T5" name="Lösung anwenden"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G2" name="Störung behoben?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T6" name="Ticket dokumentieren und schließen"><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E1" name="Incident abgeschlossen"><bpmn:incoming>f9</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T7" name="Ticket an Fachgruppe zuweisen"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task>
<bpmn:task id="T8" name="Störung im Second Level bearbeiten"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task>
<bpmn:task id="T9" name="Lösung an First Level zurückmelden"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
